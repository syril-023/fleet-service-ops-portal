# Copy this file to .streamlit/secrets.toml and fill in your values.
# On Streamlit Cloud: paste the same content into App → Settings → Secrets.
[postgres]
host     = "localhost"            # or your cloud Postgres host (e.g. a Supabase pooler)
port     = 5432
database = "fleet_ops_db"
user     = "postgres"
password = "CHANGE_ME"
# sslmode = "require"             # uncomment for a cloud database

# ── Optional integrations — leave out to run in demo mode ──
# Google Sheet that collects the technicians' job card form responses
# [google]
# sheet_id = "YOUR_SHEET_ID"

# Microsoft Graph (app registration with Files.ReadWrite.All) — writes portal updates into OneDrive Excel
# [graph]
# tenant_id     = "CHANGE_ME"
# client_id     = "CHANGE_ME"
# client_secret = "CHANGE_ME"
# user          = "owner@yourcompany.com"   # owner of the OneDrive folder with the Excel files
